# ================================
# AEGL Backend - Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ================================

# Application
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Base de données PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://aegl_user:votre_mot_de_passe@localhost:5432/aegl_db

# JWT Authentication
JWT_SECRET=remplacez_par_une_chaine_aleatoire_de_32_caracteres_minimum
JWT_EXPIRES_IN=7d

# Stockage fichiers
UPLOAD_DIR=./uploads
PDF_OUTPUT_DIR=./pdfs
MAX_FILE_SIZE_MB=10

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contact@aegl87.fr
SMTP_PASS=votre_mot_de_passe_application
EMAIL_FROM=contact@aegl87.fr
EMAIL_FROM_NAME=AEGL - Association des Étudiants Guinéens de Limoges

# Compte admin initial (utilisé lors du seed)
ADMIN_EMAIL=admin@aegl87.fr
ADMIN_PASSWORD=MotDePasseAdmin2024!
ADMIN_FIRST_NAME=Bureau
ADMIN_LAST_NAME=AEGL
