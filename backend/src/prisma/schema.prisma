generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  host
  student
}

enum Gender {
  M
  F
}

enum DossierStatus {
  pending
  host_assigned
  documents_provided
  documents_verified
  attestation_pending
  documents_ready
  confirmed
}


enum Audience {
  all
  students
  hosts
}

enum BroadcastAudience {
  all
  students
  hosts
}

model User {
  id               String    @id @default(uuid())
  firstName        String
  lastName         String
  email            String    @unique
  passwordHash     String
  role             Role
  gender           Gender
  dateOfBirth      DateTime?
  birthPlace       String?
  emailVerified    Boolean   @default(false)
  // Champs spécifiques aux hébergeurs
  lodgingSurface   Int?
  currentOccupants Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentDossiers  Dossier[]             @relation("StudentDossiers")
  hostDossiers     Dossier[]             @relation("HostDossiers")
  announcements    Announcement[]
  reactions        AnnouncementReaction[]
  comments         AnnouncementComment[]
  articles         Article[]
  activityLogs     ActivityLog[]
  collectes        Collecte[]
  pmThreads           PrivateMessage[]    @relation("PMThread")
  pmSent              PrivateMessage[]    @relation("PMSender")
  broadcasts          Broadcast[]
  broadcastReactions  BroadcastReaction[]

  @@map("users")
}

model Dossier {
  id                        String        @id @default(uuid())
  studentId                 String
  hostId                    String?
  status                    DossierStatus @default(pending)
  universityNoticePath      String?
  passportPath              String?
  aviPath                   String?
  studentDocsVerified       Boolean       @default(false)
  studentDocsRejectedReason String?
  adminNotes                String?
  pdfVariant                Int?
  hostAddress               String?
  attestationPath           String?
  mergedPdfPath             String?
  closedAt                  DateTime?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  student      User           @relation("StudentDossiers", fields: [studentId], references: [id])
  host         User?          @relation("HostDossiers", fields: [hostId], references: [id])
  hostDocuments HostDocument[]

  @@index([studentId])
  @@index([hostId])
  @@index([status])
  @@map("dossiers")
}

model HostDocument {
  id         String   @id @default(uuid())
  dossierId  String
  docType    String
  filePath   String
  verified   Boolean  @default(false)
  uploadedAt DateTime @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
  @@map("host_documents")
}

model Announcement {
  id          String    @id @default(uuid())
  authorId    String
  title       String
  content     String
  audience    Audience  @default(all)
  pinned      Boolean   @default(false)
  isPublic    Boolean   @default(false)
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  author    User                   @relation(fields: [authorId], references: [id])
  reactions AnnouncementReaction[]
  comments  AnnouncementComment[]

  @@index([audience])
  @@index([publishedAt, pinned])
  @@map("announcements")
}

model AnnouncementReaction {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  reaction       String   @default("👍")
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@map("announcement_reactions")
}

model AnnouncementComment {
  id             String   @id @default(uuid())
  announcementId String
  authorId       String
  content        String
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@index([announcementId])
  @@map("announcement_comments")
}

model Article {
  id          String   @id @default(uuid())
  authorId    String
  title       String
  slug        String   @unique
  content     String
  coverImage  String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([published, publishedAt])
  @@map("articles")
}

model Collecte {
  id           String   @id @default(uuid())
  authorId     String
  title        String
  description  String
  goal         Int?
  helloassoUrl String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([isActive, createdAt])
  @@map("collectes")
}

model PrivateMessage {
  id        String   @id @default(uuid())
  memberId  String
  senderId  String
  content   String?
  filePath  String?
  fileName  String?
  createdAt DateTime @default(now())

  member User @relation("PMThread", fields: [memberId], references: [id], onDelete: Cascade)
  sender User @relation("PMSender", fields: [senderId], references: [id])

  @@index([memberId, createdAt])
  @@map("private_messages")
}

model Broadcast {
  id        String            @id @default(uuid())
  senderId  String
  content   String?
  filePath  String?
  fileName  String?
  audience  BroadcastAudience @default(all)
  createdAt DateTime          @default(now())

  sender    User                @relation(fields: [senderId], references: [id])
  reactions BroadcastReaction[]

  @@index([audience, createdAt])
  @@map("broadcasts")
}

model BroadcastReaction {
  id          String   @id @default(uuid())
  broadcastId String
  userId      String
  emoji       String
  createdAt   DateTime @default(now())

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId, emoji])
  @@index([broadcastId])
  @@map("broadcast_reactions")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}
