generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  host
  student
}

enum Gender {
  M
  F
}

enum DossierStatus {
  pending
  host_assigned
  documents_provided
  documents_verified
  attestation_pending
  documents_ready
  confirmed
}


enum Audience {
  all
  students
  hosts
}

enum BroadcastAudience {
  all
  students
  hosts
}

model User {
  id               String    @id @default(uuid())
  firstName        String
  lastName         String
  email            String    @unique
  passwordHash     String
  role             Role
  gender           Gender
  dateOfBirth      DateTime?
  birthPlace       String?
  emailVerified    Boolean   @default(false)
  passportNumber   String?
  // Champs spécifiques aux hébergeurs
  lodgingSurface   Int?
  currentOccupants Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  studentDossiers  Dossier[]             @relation("StudentDossiers")
  hostDossiers     Dossier[]             @relation("HostDossiers")
  announcements    Announcement[]
  reactions        AnnouncementReaction[]
  comments         AnnouncementComment[]
  articles         Article[]
  activityLogs     ActivityLog[]
  collectes        Collecte[]
  pmThreads           PrivateMessage[]    @relation("PMThread")
  pmSent              PrivateMessage[]    @relation("PMSender")
  broadcasts          Broadcast[]
  broadcastReactions  BroadcastReaction[]
  lessonCompletions   LessonCompletion[]
  quizAttempts        QuizAttempt[]
  courseEnrollments   CourseEnrollment[]
  courseMessages      CourseMessage[]
  classMembers        ClassMember[]
  classGroupMessages  ClassGroupMessage[]
  notifications       Notification[]

  @@map("users")
}

model Dossier {
  id                        String        @id @default(uuid())
  studentId                 String
  hostId                    String?
  status                    DossierStatus @default(pending)
  universityNoticePath      String?
  passportPath              String?
  aviPath                   String?
  studentDocsVerified       Boolean       @default(false)
  studentDocsRejectedReason String?
  adminNotes                String?
  pdfVariant                Int?
  hostAddress               String?
  attestationPath           String?
  mergedPdfPath             String?
  closedAt                  DateTime?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  student      User           @relation("StudentDossiers", fields: [studentId], references: [id])
  host         User?          @relation("HostDossiers", fields: [hostId], references: [id])
  hostDocuments HostDocument[]

  @@index([studentId])
  @@index([hostId])
  @@index([status])
  @@map("dossiers")
}

model HostDocument {
  id         String   @id @default(uuid())
  dossierId  String
  docType    String
  filePath   String
  verified   Boolean  @default(false)
  uploadedAt DateTime @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
  @@map("host_documents")
}

model Announcement {
  id          String    @id @default(uuid())
  authorId    String
  title       String
  content     String
  audience    Audience  @default(all)
  pinned      Boolean   @default(false)
  isPublic    Boolean   @default(false)
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())

  author    User                   @relation(fields: [authorId], references: [id])
  reactions AnnouncementReaction[]
  comments  AnnouncementComment[]

  @@index([audience])
  @@index([publishedAt, pinned])
  @@map("announcements")
}

model AnnouncementReaction {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  reaction       String   @default("👍")
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId])
  @@index([announcementId])
  @@map("announcement_reactions")
}

model AnnouncementComment {
  id             String   @id @default(uuid())
  announcementId String
  authorId       String
  content        String
  createdAt      DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])

  @@index([announcementId])
  @@map("announcement_comments")
}

model Article {
  id          String   @id @default(uuid())
  authorId    String
  title       String
  slug        String   @unique
  content     String
  coverImage  String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([published, publishedAt])
  @@map("articles")
}

model Collecte {
  id           String   @id @default(uuid())
  authorId     String
  title        String
  description  String
  goal         Int?
  helloassoUrl String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])

  @@index([isActive, createdAt])
  @@map("collectes")
}

model PrivateMessage {
  id        String    @id @default(uuid())
  memberId  String
  senderId  String
  content   String?
  filePath  String?
  fileName  String?
  readAt    DateTime?
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  member User @relation("PMThread", fields: [memberId], references: [id], onDelete: Cascade)
  sender User @relation("PMSender", fields: [senderId], references: [id])

  @@index([memberId, createdAt])
  @@map("private_messages")
}

model Broadcast {
  id        String            @id @default(uuid())
  senderId  String
  content   String?
  filePath  String?
  fileName  String?
  audience  BroadcastAudience @default(all)
  createdAt DateTime          @default(now())

  sender    User                @relation(fields: [senderId], references: [id])
  reactions BroadcastReaction[]

  @@index([audience, createdAt])
  @@map("broadcasts")
}

model BroadcastReaction {
  id          String   @id @default(uuid())
  broadcastId String
  userId      String
  emoji       String
  createdAt   DateTime @default(now())

  broadcast Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, userId])
  @@index([broadcastId])
  @@map("broadcast_reactions")
}

// ── Apprentissage ────────────────────────────────────────────────────────

model Course {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String   @default("general")
  level       String   @default("tous")
  emoji       String   @default("📚")
  published   Boolean  @default(false)
  restricted  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     Lesson[]
  quizzes     Quiz[]
  resources   Resource[]
  enrollments CourseEnrollment[]
  messages    CourseMessage[]
  classGroups ClassGroupCourse[]

  @@map("courses")
}

model Lesson {
  id        String   @id @default(uuid())
  courseId  String
  title     String
  body      String?
  videoUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  course      Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completions LessonCompletion[]

  @@index([courseId])
  @@map("lessons")
}

model LessonCompletion {
  id          String   @id @default(uuid())
  lessonId    String
  userId      String
  completedAt DateTime @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([lessonId, userId])
  @@map("lesson_completions")
}

model Resource {
  id          String   @id @default(uuid())
  courseId    String?
  title       String
  description String?
  type        String   @default("link")
  url         String
  filePath    String?
  fileName    String?
  createdAt   DateTime @default(now())

  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([courseId])
  @@map("resources")
}

model Quiz {
  id          String   @id @default(uuid())
  courseId    String?
  title       String
  description String?
  createdAt   DateTime @default(now())

  course    Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([courseId])
  @@map("quizzes")
}

model QuizQuestion {
  id          String  @id @default(uuid())
  quizId      String
  question    String
  options     String
  correct     Int
  explanation String?
  order       Int     @default(0)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(uuid())
  quizId      String
  userId      String
  score       Int
  total       Int
  completedAt DateTime @default(now())

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId, userId])
  @@map("quiz_attempts")
}

model CourseEnrollment {
  id          String   @id @default(uuid())
  courseId    String
  userId      String
  role        String   @default("member")
  status      String   @default("pending")
  invitedById String?
  createdAt   DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([courseId])
  @@map("course_enrollments")
}

model CourseMessage {
  id        String   @id @default(uuid())
  courseId  String
  userId    String
  content   String?
  filePath  String?
  fileName  String?
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@map("course_messages")
}

// ── Classes / Promos ─────────────────────────────────────────────────────

model ClassGroup {
  id          String   @id @default(uuid())
  name        String
  description String?
  emoji       String   @default("🏫")
  year        String?
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  ClassMember[]
  messages ClassGroupMessage[]
  courses  ClassGroupCourse[]

  @@map("class_groups")
}

model ClassMember {
  id          String   @id @default(uuid())
  classId     String
  userId      String
  role        String   @default("student")
  status      String   @default("pending")
  invitedById String?
  createdAt   DateTime @default(now())

  class ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([classId])
  @@map("class_members")
}

model ClassGroupMessage {
  id        String   @id @default(uuid())
  classId   String
  userId    String
  content   String?
  filePath  String?
  fileName  String?
  createdAt DateTime @default(now())

  class ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([classId, createdAt])
  @@map("class_group_messages")
}

model ClassGroupCourse {
  classId  String
  courseId String
  addedAt  DateTime @default(now())

  class  ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  course Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([classId, courseId])
  @@map("class_group_courses")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("activity_logs")
}
